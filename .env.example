APP_NAME="OrderFlow Lite"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database (Supabase PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Supabase Auth & Storage
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Demo Administrator (Session-backed evaluation)
DEMO_ADMIN_ENABLED=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Session & Cache
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=array
QUEUE_CONNECTION=sync

# Optional Outbound Webhook
DEMO_WEBHOOK_URL=
